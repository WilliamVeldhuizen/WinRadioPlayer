<!--
  Builds the MSI from a published app folder. Use build-installer.ps1 in the repository root,
  which publishes the app first and passes PublishDir and ProductVersion.
  WiX 6 is used on purpose: WiX 7 requires accepting the OSMF EULA.
-->
<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.2</ProductVersion>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <OutputName>WinRadioPlayer-$(ProductVersion)-$(Platform)</OutputName>
    <Cultures>en-US</Cultures>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <!-- Nothing to compare against for a fresh product; ICE validation is slow and noisy for harvested files. -->
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="CheckPublishDir" BeforeTargets="Build">
    <Error Condition="'$(PublishDir)' == '' Or !Exists('$(PublishDir)WinRadioPlayer.exe')"
           Text="PublishDir must point to a published WinRadioPlayer (with trailing backslash). Run build-installer.ps1 from the repository root." />
  </Target>

</Project>
