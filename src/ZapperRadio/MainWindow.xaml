<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZapperRadio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZapperRadio"
    xmlns:vm="using:ZapperRadio.ViewModels"
    xmlns:models="using:ZapperRadio.Core.Models"
    Title="ZapperRadio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="CompactItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="10,0" />
            </Style>
        </Grid.Resources>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Only this part is the drag area, so the button beside it keeps receiving clicks. -->
            <StackPanel x:Name="TitleBarDragArea" Background="Transparent" Orientation="Horizontal" Spacing="10">
                <!-- The Z-bolt of the app icon. The broadcast arcs around it only crowd the Z at this size, so they are left to the larger icon frames. -->
                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                    <Path
                        Data="M42,8 L24,8 L24,15 L32,15 L23,56 L41,56 L41,49 L33,49 Z"
                        Fill="{ThemeResource ZapperMarkBrush}"
                        Width="64" Height="64"
                        Stretch="None" />
                </Viewbox>
                <TextBlock Text="ZapperRadio" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Sits left of the minimize, maximize and close buttons; its margin is set in code, as their width varies. -->
            <Button
                x:Name="ViewButton"
                Grid.Column="1"
                Style="{StaticResource IconButtonStyle}"
                Width="40" Height="32"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind local:UiHelpers.ViewToolTip(ViewModel.IsCompact), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind local:UiHelpers.ViewToolTip(ViewModel.IsCompact), Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleCompactCommand}">
                <FontIcon Glyph="{x:Bind local:UiHelpers.ViewGlyph(ViewModel.IsCompact), Mode=OneWay}" FontSize="14" />
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="12,0,12,8"
            Severity="Warning"
            IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <Grid Grid.Row="2" Padding="12,0,12,12" ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsFullView, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Favorites -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="16,14,16,8" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.FavoritesHeader, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Favorites keep playing muted in the background, so switching is instantly live: no reconnecting and no ads first. Drag a favorite up or down to reorder them."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="Zapp on ad breaks / speech"
                            IsChecked="{x:Bind ViewModel.ZappOnAdBreaks, Mode=TwoWay}"
                            ToolTipService.ToolTip="For listening to music only: when the station you are listening to starts an ad break or someone talks, zap to the highest favorite that is playing a song, and zap back as soon as it plays music again. Stations that do not mark their ads are assumed to be in an ad break when a song runs well past its length and speech is heard instead of music." />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Margin="16"
                        Text="No favorites yet. Find a station on the right and click the star."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind ViewModel.HasNoFavorites, Mode=OneWay}" />

                    <ListView
                        Grid.Row="1"
                        Padding="0,0,0,8"
                        ItemsSource="{x:Bind ViewModel.Favorites}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Favorite_ItemClick"
                        CanReorderItems="True"
                        CanDragItems="True"
                        AllowDrop="True"
                        GotFocus="Favorite_GotFocus"
                        LostFocus="Favorite_LostFocus">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteViewModel">
                                <Grid
                                    Background="Transparent"
                                    Padding="0,8" ColumnSpacing="10"
                                    PointerEntered="Favorite_PointerEntered"
                                    PointerExited="Favorite_PointerExited"
                                    PointerCanceled="Favorite_PointerExited"
                                    PointerCaptureLost="Favorite_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <!-- The remove button only shows while the row is hovered, but always keeps its place so the row does not jump. -->
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle
                                        RadiusX="1.5" RadiusY="1.5"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}" />

                                    <Grid Grid.Column="1" Width="32" Height="32" Margin="0,2,0,0" VerticalAlignment="Top">
                                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind Logo.ShowFallback, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind Logo.Initials, Mode=OneWay}"
                                            FontSize="12" FontWeight="SemiBold"
                                            Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{x:Bind Logo.ShowFallback, Mode=OneWay}" />
                                        <Image
                                            Source="{x:Bind Logo.Source, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind Logo.HasLogo, Mode=OneWay}"
                                            ImageOpened="FavoriteLogo_ImageOpened"
                                            ImageFailed="FavoriteLogo_ImageFailed" />
                                    </Grid>

                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasSong, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="11" VerticalAlignment="Center" Foreground="{x:Bind local:UiHelpers.SongBrush(IsAd, IsAssumedAdBreak), Mode=OneWay}" />
                                            <TextBlock
                                                Text="{x:Bind Song, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{x:Bind local:UiHelpers.SongBrush(IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Song, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind local:UiHelpers.StatusBrush(Status), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />                                        </StackPanel>
                                    </StackPanel>

                                    <Button
                                        Grid.Column="3"
                                        Style="{StaticResource IconButtonStyle}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ShowActions, Mode=OneWay}"
                                        ToolTipService.ToolTip="Remove from favorites"
                                        Click="RemoveFavorite_Click">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="8,4,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                            <SelectorBarItem x:Name="StationsTab" Text="Stations" IsSelected="True">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE93E;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="FavoriteTracksTab" Text="{x:Bind ViewModel.FavoriteTracksHeader, Mode=OneWay}">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE006;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="PlayHistoryTab" Text="{x:Bind ViewModel.PlayHistoryHeader, Mode=OneWay}">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE81C;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                        </SelectorBar>

                        <Button
                            Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Settings"
                            AutomationProperties.Name="Settings"
                            Click="Settings_Click">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                        </Button>
                    </Grid>

                    <!-- Station search -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsShowingStations, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16,8,16,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="SearchBox"
                                PlaceholderText="Search by name, genre or country (Ctrl+F)"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <AutoSuggestBox
                                x:Name="CountryBox"
                                Grid.Column="1"
                                PlaceholderText="Country"
                                AutomationProperties.Name="Country"
                                QueryIcon="Filter"
                                Text="{x:Bind ViewModel.SelectedCountry, Mode=OneWay}"
                                GotFocus="Country_GotFocus"
                                LostFocus="Country_LostFocus"
                                TextChanged="Country_TextChanged"
                                QuerySubmitted="Country_QuerySubmitted" />
                            <Button
                                Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32"
                                ToolTipService.ToolTip="Reload station list"
                                Command="{x:Bind ViewModel.ReloadCatalogCommand}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="16,4,16,4">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ListView
                            Grid.Row="2"
                            Padding="0,0,0,8"
                            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="Station_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StationResultViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind Subtitle}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Toggle favorite"
                                            Click="ToggleFavorite_Click">
                                            <FontIcon
                                                FontSize="16"
                                                Glyph="{x:Bind local:UiHelpers.StarGlyph(IsFavorite), Mode=OneWay}"
                                                Foreground="{x:Bind local:UiHelpers.StarBrush(IsFavorite), Mode=OneWay}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Favorite tracks -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsShowingFavoriteTracks, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Padding="16,8,16,8"
                            Text="Songs you saved with the heart next to the song that is playing. Copy a title to look it up in your music app."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="16"
                            Text="No favorite tracks yet. When a station plays a song you like, click the heart next to the song at the bottom."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.HasNoFavoriteTracks, Mode=OneWay}" />

                        <ListView
                            Grid.Row="1"
                            Padding="0,0,0,8"
                            ItemsSource="{x:Bind ViewModel.FavoriteTracks}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FavoriteTrack">
                                    <Grid Padding="0,6" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" IsTextSelectionEnabled="True" />
                                            <TextBlock
                                                Text="{x:Bind Details}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Copy title"
                                            Click="CopyFavoriteTrack_Click">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Remove from favorite tracks"
                                            Click="RemoveFavoriteTrack_Click">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Play history -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsShowingPlayHistory, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16,8,16,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="Everything your favorites played over the last 12 hours, newest first, whether or not you were listening to them. Click a heart to keep a song."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32"
                                VerticalAlignment="Top"
                                ToolTipService.ToolTip="Clear the play history"
                                AutomationProperties.Name="Clear the play history"
                                Command="{x:Bind ViewModel.ClearPlayHistoryCommand}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="16"
                            Text="Nothing played yet. As soon as your favorites are streaming, every song they play is listed here."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.HasNoPlayHistory, Mode=OneWay}" />

                        <ListView
                            Grid.Row="1"
                            Padding="0,0,0,8"
                            ItemsSource="{x:Bind ViewModel.PlayHistory}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlayedTrackViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" IsTextSelectionEnabled="True" />
                                            <TextBlock
                                                Text="{x:Bind Details}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind local:UiHelpers.SaveTrackToolTip(IsSaved), Mode=OneWay}"
                                            Click="ToggleHistoryTrackSaved_Click">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{x:Bind local:UiHelpers.HeartGlyph(IsSaved), Mode=OneWay}"
                                                Foreground="{x:Bind local:UiHelpers.HeartBrush(IsSaved), Mode=OneWay}" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Copy title"
                                            Click="CopyHistoryTrack_Click">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Compact view: the favorites, to click and listen, and nothing else. -->
        <Grid Grid.Row="2" Padding="8,0,8,8" RowSpacing="8" Visibility="{x:Bind ViewModel.IsCompact, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="10,8">
                <Grid ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.NowPlayingLogo.ShowFallback, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.NowPlayingLogo.Initials, Mode=OneWay}"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.NowPlayingLogo.ShowFallback, Mode=OneWay}" />
                        <Image
                            Source="{x:Bind ViewModel.NowPlayingLogo.Source, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind ViewModel.NowPlayingLogo.HasLogo, Mode=OneWay}"
                            ImageOpened="NowPlayingLogo_ImageOpened"
                            ImageFailed="NowPlayingLogo_ImageFailed" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.NowPlayingName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="5" Visibility="{x:Bind ViewModel.HasNowPlayingSong, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D6;" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.NowPlayingSong, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.NowPlayingSong, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Width="28" Height="28" Padding="0" Margin="0,-6"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.CanSaveNowPlayingTrack, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind local:UiHelpers.SaveTrackToolTip(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:UiHelpers.SaveTrackToolTip(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleNowPlayingTrackSavedCommand}">
                                <FontIcon
                                    FontSize="17"
                                    Glyph="{x:Bind local:UiHelpers.HeartGlyph(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                    Foreground="{x:Bind local:UiHelpers.HeartBrush(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        Width="36" Height="36" CornerRadius="18" Padding="0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Play / stop (Ctrl+Space)"
                        Command="{x:Bind ViewModel.TogglePlaybackCommand}">
                        <FontIcon Glyph="{x:Bind local:UiHelpers.PlayGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="14" />
                    </Button>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Width="32" Height="32" Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind local:UiHelpers.MuteToolTip(ViewModel.IsMuted), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:UiHelpers.MuteToolTip(ViewModel.IsMuted), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleMuteCommand}">
                            <FontIcon Glyph="{x:Bind local:UiHelpers.MuteGlyph(ViewModel.IsMuted), Mode=OneWay}" FontSize="14" />
                        </Button>
                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Volume"
                            Minimum="0" Maximum="100" StepFrequency="1"
                            Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock
                        Margin="14"
                        Text="No favorites yet. Switch to the full window to search for stations and add them with the star."
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind ViewModel.HasNoFavorites, Mode=OneWay}" />

                    <ListView
                        Padding="0,6"
                        ItemsSource="{x:Bind ViewModel.Favorites}"
                        ItemContainerStyle="{StaticResource CompactItemStyle}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Favorite_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteViewModel">
                                <Grid Height="44" ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle
                                        Height="22" VerticalAlignment="Center"
                                        RadiusX="1.5" RadiusY="1.5"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}" />

                                    <Grid Grid.Column="1" Width="28" Height="28" VerticalAlignment="Center">
                                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind Logo.ShowFallback, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind Logo.Initials, Mode=OneWay}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{x:Bind Logo.ShowFallback, Mode=OneWay}" />
                                        <Image
                                            Source="{x:Bind Logo.Source, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind Logo.HasLogo, Mode=OneWay}"
                                            ImageOpened="FavoriteLogo_ImageOpened"
                                            ImageFailed="FavoriteLogo_ImageFailed" />
                                    </Grid>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                        <TextBlock
                                            Text="{x:Bind Song, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{x:Bind local:UiHelpers.SongBrush(IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Song, Mode=OneWay}"
                                            Visibility="{x:Bind HasSong, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasNoSong, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- Green while it is live: a note for music, a speech bubble while someone talks. -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <Ellipse
                                            Width="8" Height="8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Fill="{x:Bind local:UiHelpers.IndicatorBrush(Status, IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            Visibility="{x:Bind ShowDotIndicator, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="13"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Glyph="{x:Bind local:UiHelpers.IndicatorGlyph(Sound), Mode=OneWay}"
                                            Foreground="{x:Bind local:UiHelpers.IndicatorBrush(Status, IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            Visibility="{x:Bind ShowSoundIndicator, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Now playing -->
        <Border
            Grid.Row="3"
            Visibility="{x:Bind ViewModel.IsFullView, Mode=OneWay}"
            Padding="16,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Width="48" Height="48" CornerRadius="24" Padding="0"
                    ToolTipService.ToolTip="Play / stop (Ctrl+Space)"
                    Command="{x:Bind ViewModel.TogglePlaybackCommand}">
                    <FontIcon Glyph="{x:Bind local:UiHelpers.PlayGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="18" />
                </Button>

                <Grid Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.NowPlayingLogo.ShowFallback, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NowPlayingLogo.Initials, Mode=OneWay}"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.NowPlayingLogo.ShowFallback, Mode=OneWay}" />
                    <Image
                        Source="{x:Bind ViewModel.NowPlayingLogo.Source, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind ViewModel.NowPlayingLogo.HasLogo, Mode=OneWay}"
                        ImageOpened="NowPlayingLogo_ImageOpened"
                        ImageFailed="NowPlayingLogo_ImageFailed" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.NowPlayingName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasNowPlayingSong, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D6;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <!-- Left aligned, so the heart sits right after the song and a long song is still trimmed. -->
                        <Grid Grid.Column="1" HorizontalAlignment="Left" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.NowPlayingSong, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                Width="32" Height="32" Padding="0" Margin="0,-6"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.CanSaveNowPlayingTrack, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind local:UiHelpers.SaveTrackToolTip(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:UiHelpers.SaveTrackToolTip(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleNowPlayingTrackSavedCommand}">
                                <FontIcon
                                    FontSize="20"
                                    Glyph="{x:Bind local:UiHelpers.HeartGlyph(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                    Foreground="{x:Bind local:UiHelpers.HeartBrush(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.NowPlayingStatus, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="3"
                    Width="40" Height="40" Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind local:UiHelpers.MuteToolTip(ViewModel.IsMuted), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind local:UiHelpers.MuteToolTip(ViewModel.IsMuted), Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleMuteCommand}">
                    <FontIcon Glyph="{x:Bind local:UiHelpers.MuteGlyph(ViewModel.IsMuted), Mode=OneWay}" FontSize="16" />
                </Button>
                <Slider
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Minimum="0" Maximum="100" StepFrequency="1"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Shown from the button next to the tabs; nothing of it is drawn until then. -->
        <ContentDialog
            x:Name="SettingsDialog"
            Title="Settings"
            CloseButtonText="Close"
            DefaultButton="Close">
            <StackPanel Width="380" Spacing="18">
                <StackPanel Spacing="2">
                    <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind local:UiHelpers.AboutVersion(ViewModel.AppVersion)}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="Internet radio that keeps the streams of your favorites open, so switching is instant and you do not hear the ad a station plays when you connect."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <!-- Aligned with the text above it, past the padding a button draws around its content. -->
                    <HyperlinkButton
                        Margin="-12,2,0,0"
                        Content="ZapperRadio on GitHub"
                        NavigateUri="https://github.com/WilliamVeldhuizen/ZapperRadio" />
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="Station list" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StationListName, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StationListUpdated, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        Margin="0,8,0,0"
                        Content="Check for a newer list"
                        Command="{x:Bind ViewModel.ReloadCatalogCommand}" />
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="Cached logos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="Station logos and the most-played lists are looked up once and then kept. Clearing them looks every logo up again, which helps when a station shows the wrong one. The station list itself is kept."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="{x:Bind ViewModel.CacheSummary, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        Margin="0,8,0,0"
                        Content="Clear cache"
                        Command="{x:Bind ViewModel.ClearCacheCommand}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
